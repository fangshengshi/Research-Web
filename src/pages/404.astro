---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="页面未找到 | Research Intelligence Portal">
  <main class="shell not-found"><p class="eyebrow">404 / Not found</p><h1>这条研究线索暂时不存在。</h1><p>报告可能已移动，或尚未同步到公开门户。</p><a class="button" href="/">返回首页</a></main>
</BaseLayout>
<style>.not-found{min-height:65vh;display:flex;align-items:flex-start;justify-content:center;flex-direction:column}.not-found h1{max-width:15ch;margin:0;font-family:var(--serif);font-size:clamp(2.5rem,6vw,5rem);font-weight:500;letter-spacing:-.04em;line-height:1}.not-found>p:not(.eyebrow){margin:28px 0;color:var(--ink-soft)}</style>
